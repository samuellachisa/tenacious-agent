      "confidence": 0.4
    }
  },

  "confidence_rules": {
    "high": {
      "threshold": 0.85,
      "criteria": "2+ high-weight signals detected"
    },
    "medium_high": {
      "threshold": 0.70,
      "criteria": "1 high-weight + 2 medium-weight signals"
    },
    "medium": {
      "threshold": 0.60,
      "criteria": "1 high-weight OR 2+ medium-weight signals"
    },
    "fallback": 0.30
  },

  "tuning_notes": {
    "ai_adjacent_roles": "Increase score_contribution from 2 to 3 if 5+ AI roles detected (aggressive hiring signal)",
