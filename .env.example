# ============================================================
# tenacious-agent — environment configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ------------------------------------------------------------
# KILL SWITCH — set to true only when ready for live outbound.
# When false, all emails and SMS are routed to a local sink
# (logged to Langfuse + printed to stdout). This is mandatory
# per challenge data policy and must remain false during eval.
# ------------------------------------------------------------
OUTBOUND_ENABLED=false

# ------------------------------------------------------------
# MailerSend — transactional email
# https://app.mailersend.com/api-tokens
# ------------------------------------------------------------
MAILERSEND_API_KEY=your_mailersend_api_key_here
MAILERSEND_FROM_EMAIL=outbound@tenacious.consulting
MAILERSEND_FROM_NAME=Tenacious Consulting

# ------------------------------------------------------------
# Africa's Talking — SMS (sandbox only during development)
# Username must be "sandbox" for sandbox environment.
# https://account.africastalking.com/apps/sandbox/settings/key
# ------------------------------------------------------------
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_sandbox_api_key_here
AT_SHORTCODE=15629

# ------------------------------------------------------------
# HubSpot CRM — contacts, deals, lifecycle stages
# Create a private app at: https://app.hubspot.com/private-apps
# Scopes needed: crm.objects.contacts.write, crm.objects.deals.write
# ------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ------------------------------------------------------------
# Cal.com — discovery call booking
# https://app.cal.com/settings/developer/api-keys
# CALCOM_EVENT_TYPE_ID: find in your event type URL
# ------------------------------------------------------------
CALCOM_API_KEY=your_calcom_api_key_here
CALCOM_BASE_URL=https://api.cal.com/v1
CALCOM_EVENT_TYPE_ID=123456

# ------------------------------------------------------------
# Langfuse — observability and tracing
# https://cloud.langfuse.com → Settings → API Keys
# LANGFUSE_HOST defaults to cloud; set for self-hosted installs
# ------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------
# LLM — via OpenRouter (optional enrichment enhancement)
# https://openrouter.ai/keys
# ------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=openai/gpt-4o-mini

# ------------------------------------------------------------
# Server / webhook config
# WEBHOOK_BASE_URL: public URL for receiving inbound webhooks
# ------------------------------------------------------------
WEBHOOK_BASE_URL=https://your-ngrok-or-domain.example.com

# ------------------------------------------------------------
# Data paths (relative to project root)
# ------------------------------------------------------------
CRUNCHBASE_DATA_PATH=data/crunchbase_sample.json
LAYOFFS_DATA_PATH=data/layoffs.csv
